{
  "boot-source": {
    "kernel_image_path": "@KERNEL@",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off root=/dev/vda rw init=/init lockdown=confidentiality random.trust_cpu=on spectre_bhi=on page_alloc.shuffle=1 sysctl.kernel.kptr_restrict=2 sysctl.vm.memfd_noexec=2"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "@ROOTFS@",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 512,
    "smt": false
  },
  "vsock": {
    "guest_cid": 3,
    "uds_path": "@VSOCK@"
  }
}
